#!/bin/bash
# chezmoi run_onchange_after: Install Node.js (asdf), pi and pi packages
# Runs after `chezmoi apply` whenever this script's content changes

set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}

# ── Make Homebrew + asdf available in this non-interactive shell ──────────
eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
export PATH="$HOME/.local/bin:$PATH"

if ! command -v asdf &>/dev/null; then
  echo "✗ asdf not found — run 'chezmoi apply' again after the brew install script finished." >&2
  exit 1
fi

# ── Node.js via asdf (version from ~/.tool-versions) ──────────────────────
if ! asdf plugin list 2>/dev/null | grep -qx nodejs; then
  echo "▶ Adding asdf nodejs plugin..."
  asdf plugin add nodejs
fi

node_version="$(awk '$1 == "nodejs" { print $2 }' "$HOME/.tool-versions")"
if ! asdf list nodejs 2>/dev/null | grep -q "$node_version"; then
  echo "▶ Installing Node.js $node_version via asdf..."
  asdf install nodejs "$node_version"
fi
asdf reshim nodejs

# ── pi (managed install, self-contained in ~/.pi/agent/install) ──────────
# Uses the global asdf Node.js so the installer doesn't depend on the cwd.
# A stale asdf shim can make `command -v pi` succeed, so check the managed
# install marker or a working pi instead.
pi_is_installed() {
  [[ -f "$HOME/.pi/agent/install/managed-install.json" ]] \
    || ASDF_NODEJS_VERSION="$node_version" pi --version &>/dev/null
}

if ! pi_is_installed; then
  echo "▶ Installing pi..."
  ASDF_NODEJS_VERSION="$node_version" PI_EXPERIMENTAL=1 \
    sh -c "$(curl -fsSL https://pi.dev/install.sh)"
fi

# ── pi packages (idempotent: already installed packages are skipped) ──────
echo "▶ Installing pi packages..."
ASDF_NODEJS_VERSION="$node_version" pi install https://github.com/meteyou/pi-stuff.git

echo "✓ pi setup complete!"

{{ else -}}
echo "⚠ Not macOS — skipping pi install. Install manually: https://pi.dev"
{{ end -}}
